---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Home from '../components/Home.astro';

const title = 'Elephant-Goldfish Model · Draft and review with AI';
const description =
  'Develop ideas with context and review documents with fresh eyes. An open-source plugin for AI assistants.';
---

<Base title={title} description={description}>
  <Nav />
  <main id="main">
    <Home />
  </main>
  <Footer />
</Base>

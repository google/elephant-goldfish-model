---

const repo = 'https://github.com/google/elephant-goldfish-model';

const links = [
  { label: 'Apache 2.0', href: `${repo}/blob/HEAD/LICENSE` },
  { label: 'Privacy', href: 'https://policies.google.com/privacy' },
  { label: 'Terms', href: 'https://policies.google.com/terms' },
];
---

<footer class="footer">
  <div class="wrap">
    <hr class="divider" />
    <div class="bar">
      <p class="legal muted">
        <svg class="g" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
          ></path>
          <path
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
          ></path>
          <path
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
          ></path>
          <path
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
          ></path>
        </svg>
        <span>Copyright 2026 Google LLC</span>
        <span class="sep" aria-hidden="true">&middot;</span>
        <span>This is not an officially supported Google product.</span>
      </p>
      <nav aria-label="Footer">
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 0 24px;
  }

  /* One row: legal on the left, links on the right. When the row cannot hold both,
     the links wrap under the legal line, both flush left. */
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 4px 24px;
    padding-block-start: 16px;
  }

  /* Same size as the links so the row reads as one line. */
  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font: var(--md-sys-typescale-label-md);
    font-weight: 400;
  }

  /* The G takes the legal line's color. */
  .g {
    flex: none;
    inline-size: 14px;
    block-size: 14px;
    fill: currentColor;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }

  li a {
    display: inline-flex;
    align-items: center;
    min-block-size: 24px;
    font: var(--md-sys-typescale-label-md);
    text-decoration: none;
    color: var(--md-sys-color-on-surface-variant);
  }

  li a:hover {
    color: var(--md-sys-color-on-surface);
    text-decoration: underline;
  }
</style>

---
import Button from './gb/Button.astro';
import Mark from './Mark.astro';
import { githubStars } from '../lib/github-stars';

const repo = 'https://github.com/google/elephant-goldfish-model';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const guideActive = ['/guide', '/install', '/getting-started', '/workflow'].includes(pathname);
const skillsActive = pathname === '/skills' || pathname.startsWith('/skills/');
interface Props { embedded?: boolean; }
const { embedded = false } = Astro.props;
const Tag = embedded ? 'div' : 'header';
const stars = await githubStars;
const starLabel = stars === null ? '' : stars < 1000 ? String(stars) : `${Math.round(stars / 1000)}k`;
---

<Tag class:list={['nav', { embedded }]}>
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="EGM, Elephant-Goldfish Model home">
      <Mark variant="split" size={34} />
      <span class="brand-name">Elephant-Goldfish Model</span>
      <span class="brand-short">EGM</span>
    </a>
    <div class="search-slot"><slot name="search" /></div>
    <nav class="links" aria-label="Site">
      <a href="/guide" aria-current={guideActive ? (pathname === '/guide' ? 'page' : 'location') : undefined}>Guide</a>
      <a href="/skills" aria-current={skillsActive ? (pathname === '/skills' ? 'page' : 'location') : undefined}>Skills</a>
    </nav>
    <Button class="github-link" size="sm" label={`EGM on GitHub${starLabel ? `, ${starLabel} stars` : ''}`} href={repo} target="_blank">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
      {starLabel && <span class="stars">{starLabel}</span>}
    </Button>
  </div>
</Tag>

<style>
  .nav {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: var(--md-sys-color-surface);
    border-block-end: 1px solid var(--md-sys-color-outline-variant);
    block-size:68px;
    box-sizing:border-box;
    font:500 .9375rem / 1.25 var(--md-ref-typeface-brand);
    letter-spacing:0;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    block-size: 100%;
    gap:16px;
  }

  .embedded { position:static; border:0; block-size:100%; }
  .search-slot:empty { display:none; }
  .search-slot:not(:empty) { margin-inline-start:auto; }
  .embedded .links { margin-inline-start:0; margin-inline-end:0; }
  .brand-short { display:none; }
  @media(max-width:800px) {
    .brand-name { display:none; }
    .brand-short { display:inline; }
    .nav :global(.github-link) { display:none; }
    .embedded .nav-inner { padding-inline-end:48px; }
  }
  @media(max-width:600px) { .stars { display:none; } }

  .nav .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font: 500 1.125rem / 1.25 var(--md-ref-typeface-brand);
    letter-spacing: -0.015em;
    color: light-dark(var(--md-sys-color-on-surface), #ffffff);
  }

  .links { display:flex; align-items:stretch; gap:4px; margin-inline-start:auto; align-self:stretch; }
  .nav :global(.github-link) { flex-direction:row-reverse; --icon-size:20px; --label-text-color:var(--md-sys-color-on-surface-variant); --icon-color:var(--md-sys-color-on-surface-variant); }
  .nav :global(.github-link:hover) { --label-text-color:var(--md-sys-color-on-surface); --icon-color:var(--md-sys-color-on-surface); }
  .links a { display:flex; align-items:center; align-self:center; min-block-size:40px; padding:8px 12px; font-size:.9375rem; line-height:1.25; font-weight:500; border-radius:8px; text-decoration:none; color:var(--md-sys-color-on-surface-variant); }
  .links a[aria-current] { color:var(--md-sys-color-on-secondary-container); background:var(--md-sys-color-secondary-container); }
  .links a:hover { color:var(--md-sys-color-on-surface); }

  /* Standard icon button: no container at rest, 20px glyph. */
  .nav :global(.icon-btn) {
    --icon-size: 20px;
    --icon-color: var(--md-sys-color-on-surface-variant);
  }
  .nav :global(.icon-btn:hover) { --icon-color:var(--md-sys-color-on-surface); }

  @media (max-width: 600px) {
    .links { gap:4px; margin-inline-end:0; }
    .nav-inner { gap:8px; }
  }
</style>

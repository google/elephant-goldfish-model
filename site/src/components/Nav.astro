---
import IconButton from './gb/IconButton.astro';
import Mark from './Mark.astro';

const repo = 'https://github.com/google/elephant-goldfish-model';
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top">
      <Mark variant="split" size={34} />
      <span class="brand-name">Elephant-Goldfish Model</span>
      <span class="brand-short" aria-hidden="true">EGM</span>
    </a>
    <IconButton label="EGM on GitHub" href={repo} target="_blank">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
    </IconButton>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: var(--md-sys-color-surface);
    border-block-end: 1px solid var(--md-sys-color-outline-variant);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    block-size: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font: 500 1.125rem / 1.25 var(--md-ref-typeface-brand);
    letter-spacing: -0.015em;
    color: var(--md-sys-color-on-surface);
  }

  .brand-short {
    display: none;
  }

  /* Standard icon button: no container at rest, 24px glyph. */
  .nav :global(.icon-btn) {
    --icon-size: 24px;
    --icon-color: var(--md-sys-color-on-surface);
    margin-inline-end: -8px;
  }

  @media (max-width: 480px) {
    .brand-name {
      display: none;
    }

    .brand-short {
      display: inline;
    }
  }
</style>
